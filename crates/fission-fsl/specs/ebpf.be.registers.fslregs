layout ebpf.be.registers {
    evidence "ghidra-snapshot" "https://github.com/fission-systems/Fission/blob/96fc71f75cecdee305faf9497561c577a8955468/utils/sleigh-specs/languages/eBPF/eBPF.sinc" "sha256:7b69ca1e901dca162bae29a8f18819c5f84afc3195296cf1662e39d86bbf5a34" "Unconditional space/register declaration prefix; byte offsets, holes and overlapping views retained. No instruction or subregister extension semantics inferred.";
    evidence "ghidra-snapshot" "https://github.com/fission-systems/Fission/blob/96fc71f75cecdee305faf9497561c577a8955468/utils/sleigh-specs/languages/eBPF/eBPF_be.slaspec" "sha256:1dffeac5a171eb8cc6c5353a4055f838a8d7adf0e2052b62a5716bd85b294435" "Entry fixes byte order for the admitted declaration prefix.";
    default_space "ram";
    space "ram" memory 8 byte big;
    space "register" register 4 byte big;
    space "syscall" memory 4 byte big;
    register "R0" "register" 0 8;
    register "R1" "register" 8 8;
    register "R2" "register" 16 8;
    register "R3" "register" 24 8;
    register "R4" "register" 32 8;
    register "R5" "register" 40 8;
    register "R6" "register" 48 8;
    register "R7" "register" 56 8;
    register "R8" "register" 64 8;
    register "R9" "register" 72 8;
    register "R10" "register" 80 8;
    register "PC" "register" 88 8;
}
