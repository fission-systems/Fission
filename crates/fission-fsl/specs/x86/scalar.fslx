frontend x86.scalar {
decoder owned-x86-v1;
rule mov_rm_reg 89 ff - rm_reg mov{width}_reg;
rule mov_reg_rm 8b ff - reg_rm mov{width}_reg;
rule add_rm_reg 01 ff - rm_reg add{width}_reg;
rule add_reg_rm 03 ff - reg_rm add{width}_reg;
rule add_acc_imm 05 ff - acc_imm add{width}_imm;
rule add_rm_imm 81 ff 0 rm_imm add{width}_imm;
rule add_rm_simm8 83 ff 0 rm_simm8 add{width}_imm;
rule sub_rm_reg 29 ff - rm_reg sub{width}_reg;
rule sub_reg_rm 2b ff - reg_rm sub{width}_reg;
rule sub_acc_imm 2d ff - acc_imm sub{width}_imm;
rule sub_rm_imm 81 ff 5 rm_imm sub{width}_imm;
rule sub_rm_simm8 83 ff 5 rm_simm8 sub{width}_imm;
rule cmp_rm_reg 39 ff - rm_reg cmp{width}_reg;
rule cmp_reg_rm 3b ff - reg_rm cmp{width}_reg;
rule cmp_acc_imm 3d ff - acc_imm cmp{width}_imm;
rule cmp_rm_imm 81 ff 7 rm_imm cmp{width}_imm;
rule cmp_rm_simm8 83 ff 7 rm_simm8 cmp{width}_imm;
rule and_rm_reg 21 ff - rm_reg and{width}_reg;
rule and_reg_rm 23 ff - reg_rm and{width}_reg;
rule and_acc_imm 25 ff - acc_imm and{width}_imm;
rule and_rm_imm 81 ff 4 rm_imm and{width}_imm;
rule and_rm_simm8 83 ff 4 rm_simm8 and{width}_imm;
rule or_rm_reg 09 ff - rm_reg or{width}_reg;
rule or_reg_rm 0b ff - reg_rm or{width}_reg;
rule or_acc_imm 0d ff - acc_imm or{width}_imm;
rule or_rm_imm 81 ff 1 rm_imm or{width}_imm;
rule or_rm_simm8 83 ff 1 rm_simm8 or{width}_imm;
rule xor_rm_reg 31 ff - rm_reg xor{width}_reg;
rule xor_reg_rm 33 ff - reg_rm xor{width}_reg;
rule xor_acc_imm 35 ff - acc_imm xor{width}_imm;
rule xor_rm_imm 81 ff 6 rm_imm xor{width}_imm;
rule xor_rm_simm8 83 ff 6 rm_simm8 xor{width}_imm;
rule test_rm_reg 85 ff - rm_reg test{width}_reg;
rule test_acc_imm a9 ff - acc_imm test{width}_imm;
rule mov_opreg_imm b8 f8 - opreg_imm mov{width}_imm;
rule mov_rm_imm c7 ff 0 rm_imm mov{width}_imm;
rule test_rm_imm f7 ff 0 rm_imm test{width}_imm;
rule lea 8d ff - lea lea{width};
rule ret c3 ff - ret ret{width};
rule nop 90 ff - nop direct;
rule jmp_short eb ff - branch8 direct;
rule jmp_near e9 ff - branch direct;
rule je_short 74 ff - branch8 je;
rule je_near 0f84 ff - branch je;
rule jne_short 75 ff - branch8 jne;
rule jne_near 0f85 ff - branch jne;
}
