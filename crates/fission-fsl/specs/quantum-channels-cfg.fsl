instruction cfg_correct { opcode 31; mnemonic "cfg_correct"; evidence "authored" "https://github.com/Qiskit/qiskit-aer/blob/main/qiskit_aer/noise/errors/standard_errors.py" "channels-v1" "Synthetic logical selector, not a physical QPU opcode or calibrated noise."; semantics { block entry() { quantum.h 0; quantum.cx 0,1; %a:u1=quantum.measure_z 0; branch.if %a, yes(%a), no(%a); } block yes(%b:u1) { quantum.x 1; branch join(%b); } block no(%c:u1) { branch join(%c); } block join(%d:u1) { %out:u1=quantum.measure_z 1; return; } } }
instruction cfg_noise { opcode 32; mnemonic "cfg_noise"; evidence "authored" "https://github.com/Qiskit/qiskit-aer/blob/main/qiskit_aer/noise/errors/standard_errors.py" "channels-v1" "Synthetic logical selector, not a physical QPU opcode or calibrated noise."; semantics { block entry() { quantum.h 0; %a:u1=quantum.measure_z 0; branch.if %a, noisy(%a), quiet(%a); } block noisy(%b:u1) { quantum.amplitude_damping 1,1,3; %m:u1=quantum.measure_z 1; branch join(%m); } block quiet(%c:u1) { quantum.phase_flip 1,1,2; branch join(%c); } block join(%d:u1) { quantum.x_if 0,%d; %out:u1=quantum.measure_z 0; return; } } }
instruction cfg_parameters { opcode 33; mnemonic "cfg_parameters"; evidence "authored" "https://github.com/Qiskit/qiskit-aer/blob/main/qiskit_aer/noise/errors/standard_errors.py" "channels-v1" "Synthetic logical selector, not a physical QPU opcode or calibrated noise."; semantics { block entry() { %a:u1=int.const 0; %b:u1=int.const 1; quantum.h 0; branch swap(%b,%a); } block swap(%c:u1,%d:u1) { quantum.x_if 0,%c; quantum.bit_flip 0,1,3; branch.if %d, yes(), no(); } block yes() { quantum.x 0; return; } block no() { quantum.z 0; return; } } }
